{
  "name": "code-journal",
  "version": "1.0.0",
  "description": "Captures every coding-platform submission and commits it to your own GitHub repository.",
  "scripts": {
    "test": "vitest run",
    "build": "npm run typecheck && vite build --mode background && vite build --mode content && vite build --mode leetcode-page && vite build --mode gfg-page && vite build --mode popup",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:firefox": "npm run build && node scripts/build-firefox.js",
    "package:firefox": "node scripts/package.js firefox",
    "package:chrome": "node scripts/package.js chrome",
    "package:source": "node scripts/package.js source",
    "sign:firefox": "web-ext sign --source-dir dist-firefox --artifacts-dir artifacts --channel unlisted --upload-source-code artifacts/code-journal-source-$npm_package_version.zip",
    "icons": "python3 scripts/generate-icons.py"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "web-ext": "^10.7.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akash-Kanojia/code-journal.git"
  },
  "author": "Akash Kanojia"
}
